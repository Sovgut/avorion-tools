{
  "name": "avorion-tools",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://sovgut.github.io/avorion-tools/",
  "scripts": {
    "dev": "vite",
    "dev:expose": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "analyze": "tsx analyzer/index.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "format": "biome check --write .",
    "verify": "tsx tools/verify/index.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@reduxjs/toolkit": "2.13.0",
    "clsx": "^2.1.1",
    "comlink": "4.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@biomejs/biome": "2.5.15",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/luaparse": "^0.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "gh-pages": "6.3.0",
    "luaparse": "^0.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
